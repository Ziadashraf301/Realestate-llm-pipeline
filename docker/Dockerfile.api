# docker/Dockerfile.api
# FastAPI Real Estate Intelligence System
FROM python:3.11-slim

# Install Astral uv binary from official image (10-100x faster than pip)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    UV_SYSTEM_PYTHON=1

WORKDIR /app

# 1. Copy dependency definition first for Docker layer caching
COPY pyproject.toml ./

# 2. Pre-install production + dev (pytest, ruff) dependencies (cached unless pyproject.toml changes)
RUN uv pip install --system --extra dev -r pyproject.toml

# 3. Copy application source code and tests
COPY src/ ./src/
COPY tests/ ./tests/

# 4. Link package without reinstalling dependencies (< 0.1s)
RUN uv pip install --system --no-deps -e "."

# Create non-root user for security compliance
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose FastAPI port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Start uvicorn
CMD ["uvicorn", "real_estate.main:app", "--host", "0.0.0.0", "--port", "5000", "--workers", "2"]

